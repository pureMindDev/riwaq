# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000
# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of this server (0 = none, e.g. local dev). Set to 1 behind a typical
# host/load balancer so the sign-in rate limit sees each visitor's real IP. Do not set it if you are not
# behind a proxy: clients could then fake their IP.
TRUST_PROXY=0

# MongoDB connection string (local MongoDB, or a MongoDB Atlas URI). Required.
MONGODB_URI=mongodb://127.0.0.1:27017/digital-tahfidh

# Recording uploads allowed per signed-in learner per 15 minutes.
UPLOAD_RATE_LIMIT_MAX=60

# Login sessions last this many days.
SESSION_DAYS=30

# Quran Foundation Content API (https://dev-console.quran.foundation/projects)
# Create a Server app with "API access only". Keep the secret private.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# "prelive" (only some Surahs) or "production" (needs approval)
QF_ENV=prelive
# Optional overrides (normally leave blank):
# QF_AUTH_URL=
# QF_API_URL=
# Where relative audio paths are resolved. UNVERIFIED default; adjust if audio does not play.
# QF_AUDIO_BASE_URL=https://verses.quran.com/

# Optional: URL of a Qur'an recitation recognition service (see docs/RECITATION.md).
RECITATION_ENGINE_URL=
RECITATION_ENGINE_TIMEOUT_MS=30000
# Keep false until the engine has been checked against qualified teachers' marking.
RECITATION_ENGINE_VALIDATED=false

# Optional: AI letter check for the Foundation letter cards (see engine/README.md). Leave blank to use the browser's
# built-in speech recognition (beta) instead.
LETTER_ENGINE_URL=
LETTER_ENGINE_KEY=
# Signs the receipt that spoken quiz questions need. Set a long random value if you run more than one server.
LETTER_PROOF_SECRET=

# DEVELOPMENT ONLY. Leave false. When true, progress can be claimed without a recitation the Muallim has passed.
ALLOW_SELF_DECLARATION=false
